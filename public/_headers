# The AI room runs a WebAssembly engine that needs SharedArrayBuffer, so it must
# be cross-origin isolated. The engine files below /ai/ need the same headers.
/ai
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/ai/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Only https://chuhanxiangqi.com is for search engines. Staging and the workers.dev
# addresses serve the same pages, so they ask not to be indexed.
https://staging.chuhanxiangqi.com/*
  X-Robots-Tag: noindex
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
