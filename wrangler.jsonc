{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuhan-xiangqi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "observability": { "enabled": true },
  // The domain is the public address. Wrangler turns workers.dev off once routes
  // exist unless asked, and older invitation links still point there.
  "workers_dev": true,
  "routes": [{ "pattern": "chuhanxiangqi.com", "custom_domain": true }],
  "assets": {
    // Pages are static; only /api/* wakes the Worker, so page views cost nothing.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuhan-xiangqi",
      // Production database. Local development ignores the id and uses a local copy.
      "database_id": "b3d25de9-4e07-4d19-a3ba-935b21fb1c5b",
      "migrations_dir": "drizzle"
    }
  ],
  // Friend rooms made since M2: one Durable Object each (SQLite storage, the only kind the
  // free plan has), and one per player listing the rooms they sit in.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "SEATS", "class_name": "PlayerSeats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "PlayerSeats"] }
  ],
  "env": {
    "staging": {
      "name": "chuhan-xiangqi-staging",
      "observability": { "enabled": true },
      "workers_dev": true,
      "routes": [
        { "pattern": "staging.chuhanxiangqi.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chuhan-xiangqi-staging",
          "database_id": "8e0a4377-ad05-4245-ae69-bca90843f398",
          "migrations_dir": "drizzle"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "GameRoom" },
          { "name": "SEATS", "class_name": "PlayerSeats" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom", "PlayerSeats"] }
      ]
    }
  }
}
