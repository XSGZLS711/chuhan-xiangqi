{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuhan-xiangqi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  // Workers Logs keeps what the code logs (visits, client errors, onError). Invocation
  // logs stay off: they record request headers and the IP, which public/privacy.html
  // says we do not keep.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The domain is the public address. Wrangler turns workers.dev off once routes
  // exist unless asked, and older invitation links still point there.
  "workers_dev": true,
  "routes": [{ "pattern": "chuhanxiangqi.com", "custom_domain": true }],
  "assets": {
    // Pages are static; only /api/* wakes the Worker, so page views cost nothing.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuhan-xiangqi",
      // Production database. Local development ignores the id and uses a local copy.
      "database_id": "b3d25de9-4e07-4d19-a3ba-935b21fb1c5b",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "name": "chuhan-xiangqi-staging",
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      },
      "workers_dev": true,
      "routes": [
        { "pattern": "staging.chuhanxiangqi.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chuhan-xiangqi-staging",
          "database_id": "8e0a4377-ad05-4245-ae69-bca90843f398",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
