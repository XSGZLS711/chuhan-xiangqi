# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# local tooling
/.claude/

# local study material (screenshots/recordings of other apps), never published
/research/

# local Worker secrets (Google sign-in)
.dev.vars*

# The Android app (docs/google-play.md). Only android/twa-manifest.json is ours: Bubblewrap
# makes the Android project from it, and the build writes the packages next to it. The
# upload key stays on the owner's machine, wherever it is kept.
/android/*
!/android/twa-manifest.json
*.keystore
*.jks
*.p12
*.aab
*.apk
*.idsig
